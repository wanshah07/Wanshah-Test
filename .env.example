# Copy to .env and fill in. Never commit .env: this repository is public.

# Port the server listens on.
PORT=8787

# Where the SQLite database, uploaded sources and media live. Mount this
# as a volume in Docker.
DATA_DIR=./data

# 32+ random characters. Encrypts stored OpenAI keys and signs sessions.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# off   = single-user, no login screen (default for local use)
# local = email + password accounts; add the first one with `npm run user:add`
AUTH_MODE=off

# Optional server-wide OpenAI key. A key saved in Settings by a user takes
# precedence over this one.
OPENAI_API_KEY=

# Models. Change here or per user in Settings.
OPENAI_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional backups. When a call fails on the main endpoint (down, out of
# quota, model refused, unusable answer) it is tried on each backup in turn,
# and the job log says so. Each key is only ever sent to its own address.
# A model written with +vision reads pictures: uploaded pictures go to it.
MIRELD_API_KEY=
# MIRELD_BASE_URL=https://api.mireld.my/v1
# MIRELD_MODELS=deepseek-v4-pro
AFIQ_API_KEY=
# The base URL from AfiqStore's Docs page, ending in /v1.
AFIQ_BASE_URL=
# AFIQ_MODELS=kimi-k3, kimi-k2.7+vision
# AI_ROUTE_ORDER=mireld, afiq

# Optional. Application (client) ID of a Microsoft app registration, for
# pulling pictures from OneDrive. Not a secret, but keep it out of the repo.
# Each user can also enter one in Settings. See README, "Pictures from OneDrive".
MS_CLIENT_ID=

# Set to 1 to run without any OpenAI call: generation returns a fixture deck.
# Used by the tests and for trying the editor before a key is set up.
MOCK_LLM=0
